{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "noEmit": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/index.ts"]
}
